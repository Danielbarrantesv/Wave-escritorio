*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.pfx
*.cer
*.appxsym
*.bld
*.suo

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResults/
coverage-report/
coverage.cobertura.xml
*.coverage
*.coveragexml

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
