*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/build/

# Build results
[Dd]ebugPublic/
[Rr]eleasePublic/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishProfiles/

# Microsoft Azure
PublishScripts/
*.Publish.xml

