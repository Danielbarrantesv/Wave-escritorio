# Logs
*.log
logs/

# Certificados (NUNCA commitear)
*.pfx
*.p12
*.key
*.pem
secrets.json
appsettings.Development.json
appsettings.Local.json

# User secrets
secrets.json

# Database files (development)
*.db
*.db-shm
*.db-wal
!Migrations/*.sql

# Archivos temporales
*.tmp
*.bak
*.swp
*~

# Cover art cache (generados en runtime)
