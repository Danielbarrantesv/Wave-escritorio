<Application x:Class="Wave.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wave.Windows.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/AccentColors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Plantilla de Slider custom para el mini player:
                 track blanco semi-transparente + relleno verde + bolita circular -->
            <ControlTemplate x:Key="MiniSliderTemplate" TargetType="Slider">
                <Grid Height="14" VerticalAlignment="Center">
                    <!-- Track completo: borde blanco semi-transparente -->
                    <Border Height="4" VerticalAlignment="Center"
                            Background="#33FFFFFF" CornerRadius="2"/>
                    <!-- Relleno verde que crece a la izquierda del thumb -->
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="#32C98B" CornerRadius="2"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="14" Height="14">
                                            <!-- Glow verde detrás -->
                                            <Ellipse Fill="#32C98B" Opacity="0.3" Width="20" Height="20"/>
                                            <!-- Bolita principal -->
                                            <Ellipse Fill="#32C98B" Stroke="White" StrokeThickness="1.5"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate>

            <!-- Converters globales disponibles en todos los XAML -->
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <conv:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
            <conv:MsToTextConverter x:Key="MsToTextConverter"/>
            <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
