<Application x:Class="Wave.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wave.Windows.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/AccentColors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters globales disponibles en todos los XAML -->
            <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <conv:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
            <conv:MsToTextConverter x:Key="MsToTextConverter"/>
            <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
