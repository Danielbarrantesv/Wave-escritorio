<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Wave</AssemblyName>
    <RootNamespace>Wave.Windows</RootNamespace>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Company>Daniel Barrantes</Company>
    <Product>Wave for Windows</Product>
    <Description>Reproductor de música offline para Windows 10/11</Description>
    <Copyright>Copyright (c) 2026 Daniel Barrantes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Danielbarrantesv/Wave-escritorio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Danielbarrantesv/Wave-escritorio.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Alta DPI PerMonitorV2 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- MSIX packaging (v1.0.0) — desactivado por defecto porque requiere certificado.
         Para empaquetar MSIX: -p:WindowsPackageType=MSIX -p:PackageCertificateKeyFile=cert.pfx
         El Package.appxmanifest ya está preparado.
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained true: NO requiere .NET 8 Runtime instalado en la máquina destino.
         El ejecutable incluye el runtime de .NET (~70 MB) pero funciona en cualquier Windows 10+ -->
    <SelfContained>true</SelfContained>
    <!-- Single file: el .exe incluye todos los DLLs extraídos a memoria al arrancar -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\Migrations\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- AppxManifest NO se incluye en el build normal (solo para MSIX packaging).
         Se mantiene en el repo para cuando se quiera empaquetar MSIX. -->
    <None Update="Package.appxmanifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
