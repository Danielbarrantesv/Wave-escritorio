<Window x:Class="Wave.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wave.Windows.Views.Controls"
        Title="Wave" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar con título + búsqueda + botones -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Wave" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>

            <!-- Search box en tiempo real -->
            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     Background="{DynamicResource SurfaceVariantBrush}"
                     Foreground="{DynamicResource OnSurfaceBrush}"
                     BorderThickness="0"
                     Padding="12,8"
                     Margin="16,12"
                     VerticalContentAlignment="Center"
                     Tag="Buscar canciones, artistas, álbumes..."/>

            <Button Grid.Column="2" Click="AddMusic_Click"
                    Content="+ Agregar música"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="Black" FontWeight="SemiBold"/>
            <Button Grid.Column="3" Click="Lyrics_Click"
                    Content="♪ Letra"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Mostrar letra sincronizada"/>
            <Button Grid.Column="4" Click="Equalizer_Click"
                    Content="EQ"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Ecualizador"/>
            <Button Grid.Column="5" Click="Settings_Click"
                    Content="⚙"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Configuración"/>
            <Button Grid.Column="6" Click="MiniPlayer_Click"
                    Content="⊞"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Mini player flotante"/>
            <Button Grid.Column="7" Click="Backup_Click"
                    Content="💾"
                    Padding="12,6" Margin="0,0,16,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Backup / Restore"/>
        </Grid>

        <!-- Contenido principal: sidebar + lista -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar de playlists -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource OutlineBrush}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Playlists"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="16,12,16,8"/>

                    <ListBox x:Name="PlaylistsList"
                             ItemsSource="{Binding Playlists}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="PlaylistsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                    <TextBlock Text="&#x1F3B5;"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Lista de canciones -->
            <Grid Grid.Column="1">
                <!-- Header con info de biblioteca + sort chip -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sort chip row -->
                <Grid Grid.Row="0" Margin="16,8,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SongCountLabel"
                               Text="0 canciones"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"/>

                    <!-- Sort chip -->
                    <Button Grid.Column="2"
                            x:Name="SortChip"
                            Click="Sort_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇅" Margin="0,0,4,0"/>
                            <TextBlock x:Name="SortLabel" Text="Recientes"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SortMenu">
                                <MenuItem Header="Recientes" Click="SortRecentlyAdded_Click"/>
                                <MenuItem Header="Reproducidas" Click="SortRecentlyPlayed_Click"/>
                                <MenuItem Header="Título" Click="SortTitle_Click"/>
                                <MenuItem Header="Artista" Click="SortArtist_Click"/>
                                <MenuItem Header="Duración" Click="SortDuration_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding SongCount, Converter={StaticResource ZeroToVisibleConverter}}">
                    <TextBlock Text="Aún no hay música en tu biblioteca"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Arrastra archivos MP3/FLAC/M4A aquí o usa el botón superior"
                               FontSize="13"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Click="AddMusic_Click"
                            Content="Seleccionar carpeta"
                            Padding="16,8"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="Black" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ListView de canciones con data binding -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding SongsView}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="SongRow_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4" Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"/>

                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayArtist}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayAlbum}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="3"
                                        Click="Favorite_Click"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Content="&#x2665;"
                                        FontSize="18"
                                        ToolTip="Marcar/desmarcar como favorito"
                                        Tag="{Binding}"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding DisplayDuration}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- PlayerBar (UserControl custom) -->
        <controls:PlayerBar Grid.Row="2" x:Name="PlayerBarControl"/>
    </Grid>
</Window>
