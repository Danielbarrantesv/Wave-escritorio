<Window x:Class="Wave.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wave" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar con botón "Agregar música" -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Wave" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SongCount, StringFormat=\{0\} canciones, FallbackValue=0 canciones}"
                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Click="AddMusic_Click"
                    Content="+ Agregar música"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="Black" FontWeight="SemiBold"/>
            <Button Grid.Column="3" Click="Lyrics_Click"
                    Content="♪ Letra"
                    Padding="12,6" Margin="0,0,16,0"
                    Background="Transparent"
                    Foreground="{DynamicResource OnSurfaceVariantBrush}"
                    ToolTip="Mostrar letra sincronizada"/>
        </Grid>

        <!-- Contenido principal: sidebar + lista -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar de playlists -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource OutlineBrush}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Playlists"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="16,12,16,8"/>

                    <ListBox x:Name="PlaylistsList"
                             ItemsSource="{Binding Playlists}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="PlaylistsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                    <TextBlock Text="&#x1F3B5;"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Lista de canciones (con empty state) -->
            <Grid Grid.Column="1">
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding SongCount, Converter={StaticResource ZeroToVisibleConverter}}">
                    <TextBlock Text="Aún no hay música en tu biblioteca"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Arrastra archivos MP3/FLAC/M4A aquí o usa el botón superior"
                               FontSize="13"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Click="AddMusic_Click"
                            Content="Seleccionar carpeta"
                            Padding="16,8"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="Black" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Lista de canciones -->
                <ListView ItemsSource="{Binding Songs}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="SongRow_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4" Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cover art placeholder -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"/>

                                <!-- Título + artista -->
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayArtist}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Álbum -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayAlbum}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Botón Favorito (corazón) -->
                                <Button Grid.Column="3"
                                        Click="Favorite_Click"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Content="&#x2665;"
                                        FontSize="18"
                                        ToolTip="Marcar/desmarcar como favorito"
                                        Tag="{Binding}"/>

                                <!-- Duración -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding DisplayDuration}"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Player bar con bindings a PlaybackController -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceVariantBrush}" Height="72">
            <Grid Margin="12,8" DataContext="{Binding Playback, Source={StaticResource Playback}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="4"/>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue='No hay canción'}"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue='—'}"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Slider Grid.Column="2"
                        Minimum="0"
                        Maximum="{Binding DurationMs}"
                        Value="{Binding PositionMs}"
                        VerticalAlignment="Center"
                        Margin="12,0"/>

                <Button Grid.Column="3" Click="Shuffle_Click" Background="Transparent"
                        Foreground="{DynamicResource OnSurfaceBrush}"
                        Content="&#x1F500;" ToolTip="Aleatorio"/>
                <Button Grid.Column="4" Click="Prev_Click" Background="Transparent"
                        Foreground="{DynamicResource OnSurfaceBrush}"
                        Content="&#x23EE;" ToolTip="Anterior"/>
                <Button Grid.Column="5" Click="PlayPause_Click" Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}"
                        Content="&#x25B6;" ToolTip="Reproducir/Pausar"/>
                <Button Grid.Column="6" Click="Next_Click" Background="Transparent"
                        Foreground="{DynamicResource OnSurfaceBrush}"
                        Content="&#x23ED;" ToolTip="Siguiente"/>
                <Button Grid.Column="7" Click="Repeat_Click" Background="Transparent"
                        Foreground="{DynamicResource OnSurfaceBrush}"
                        Content="&#x1F501;" ToolTip="Repetir"/>
            </Grid>
        </Border>
    </Grid>
</Window>
