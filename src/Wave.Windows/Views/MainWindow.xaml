<Window x:Class="Wave.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Wave" Height="720" Width="1200"
        MinHeight="400" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        StateChanged="Window_StateChanged">
    <Window.InputBindings>
        <KeyBinding Command="{x:Static MediaCommands.Play}" Key="MediaPlay" />
        <KeyBinding Command="{x:Static MediaCommands.Pause}" Key="MediaPause" />
        <KeyBinding Command="{x:Static MediaCommands.TogglePlayPause}" Key="MediaPlayPause" />
        <KeyBinding Command="{x:Static MediaCommands.NextTrack}" Key="MediaNextTrack" />
        <KeyBinding Command="{x:Static MediaCommands.PreviousTrack}" Key="MediaPreviousTrack" />
        <KeyBinding Command="{x:Static MediaCommands.Stop}" Key="MediaStop" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static MediaCommands.Play}" Executed="MediaPlay_Executed" />
        <CommandBinding Command="{x:Static MediaCommands.Pause}" Executed="MediaPause_Executed" />
        <CommandBinding Command="{x:Static MediaCommands.TogglePlayPause}" Executed="MediaTogglePlayPause_Executed" />
        <CommandBinding Command="{x:Static MediaCommands.NextTrack}" Executed="MediaNextTrack_Executed" />
        <CommandBinding Command="{x:Static MediaCommands.PreviousTrack}" Executed="MediaPreviousTrack_Executed" />
        <CommandBinding Command="{x:Static MediaCommands.Stop}" Executed="MediaStop_Executed" />
    </Window.CommandBindings>
    <Grid>
        <wv2:WebView2 x:Name="WebView"
                      NavigationStarting="WebView_NavigationStarting"/>
    </Grid>
</Window>
