<Window x:Class="Wave.Windows.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wave Mini" Height="64" Width="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#DD1A1A1A" CornerRadius="10" Padding="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <!-- Cover art cuadrada -->
            <Border Grid.Column="0" Background="#32C98B" CornerRadius="4">
                <Image Source="{Binding CurrentSong.ArtUri}" Stretch="UniformToFill"/>
            </Border>

            <!-- Título + artista -->
            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue='No hay canción'}"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue='—'}"
                           Foreground="#99FFFFFF" FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Botones con iconos SVG-like -->
            <Button Grid.Column="2" Click="Prev_Click" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Anterior">
                <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="White" Height="14" Width="14" Stretch="Uniform"/>
            </Button>
            <Button Grid.Column="3" Click="PlayPause_Click" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Reproducir/Pausar">
                <Path x:Name="PlayPauseIcon" Data="M8 5v14l11-7z" Fill="#32C98B" Height="16" Width="16" Stretch="Uniform"/>
            </Button>
            <Button Grid.Column="4" Click="Next_Click" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Siguiente">
                <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="White" Height="14" Width="14" Stretch="Uniform"/>
            </Button>
            <Button Grid.Column="5" Click="Close_Click" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Cerrar">
                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#99FFFFFF" Height="10" Width="10" Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</Window>
