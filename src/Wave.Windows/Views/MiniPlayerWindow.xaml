<Window x:Class="Wave.Windows.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wave Mini" Height="70" Width="350"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#DD1A1A1A" CornerRadius="10" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <!-- Cover art cuadrada: click abre reproductor principal -->
                <Border Grid.Column="0" Background="#32C98B" CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="Cover_Click" Width="54" Height="54">
                    <Image Source="{Binding CurrentSong.ArtUri}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Info_Click">
                    <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue='No hay canción'}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue='—'}"
                               Foreground="#99FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Botones -->
                <Button Grid.Column="2" Click="Prev_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Anterior">
                    <Path Data="M5.5,18V6h2V18h-2Zm13,0l-9-6l9-6V18Zm-2-6Zm0,2.25V9.75L13.1,12l3.4,2.25Z" Fill="White" Height="14" Width="14" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="3" Click="PlayPause_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Play/Pausa">
                    <Path x:Name="PlayPauseIcon" Data="M8,19V5l11,7L8,19Zm2-7Zm0,3.35L15.25,12L10,8.65v6.7Z" Fill="#32C98B" Height="16" Width="16" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="4" Click="Next_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Siguiente">
                    <Path Data="M16.5,18V6h2V18h-2Zm-11,0V6l9,6l-9,6Zm2-6Zm0,2.25L10.9,12L7.5,9.75v4.5Z" Fill="White" Height="14" Width="14" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="5" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar">
                    <Path Data="M6.4,19L5,17.6L10.6,12L5,6.4L6.4,5L12,10.6L17.6,5L19,6.4L13.4,12L19,17.6L17.6,19L12,13.4L6.4,19Z" Fill="#99FFFFFF" Height="12" Width="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- Barra de progreso: ProgressBar (relleno verde) + Slider (bolita arrastrable) -->
            <Grid Grid.Row="1" Margin="0,2,0,0" Height="10" VerticalAlignment="Center">
                <!-- Relleno de fondo blanco semi-transparente -->
                <Border Background="#33FFFFFF" CornerRadius="2"/>
                <!-- Relleno verde que se llena según el progreso -->
                <ProgressBar x:Name="ProgressFill" Minimum="0" Maximum="100" Value="0"
                             Background="Transparent" Foreground="#32C98B"
                             BorderThickness="0"/>
                <!-- Slider con bolita circular encima, transparente para que se vea el relleno -->
                <Slider x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                        Background="Transparent" Foreground="Transparent"
                        BorderThickness="0"
                        TickFrequency="1" IsSnapToTickEnabled="False"
                        Thumb.DragStarted="ProgressBar_DragStarted"
                        Thumb.DragCompleted="ProgressBar_DragCompleted"
                        ValueChanged="ProgressBar_ValueChanged"
                        Template="{StaticResource MiniSliderTemplate}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
