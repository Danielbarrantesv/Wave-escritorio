<UserControl x:Class="Wave.Windows.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black">
    <Grid>
        <!-- Layer 1: Portada de fondo (blur + stretched) -->
        <Image Source="{Binding CurrentSong.ArtUri}"
               Stretch="UniformToFill"
               Opacity="0.5"/>

        <!-- Layer 2: Scrim oscuro para legibilidad -->
        <Rectangle Fill="#C0000000"/>

        <!-- Layer 3: Loading overlay -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBlock Text="Buscando letra..."
                       Foreground="White"
                       FontSize="16"
                       HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Margin="0,12,0,0"
                         Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>

        <!-- Layer 4: Empty state (sin letra encontrada) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding LyricsNotFound, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBlock Text="♪"
                       FontSize="64"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Letra no disponible"
                       Foreground="White"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="No se encontró letra para esta canción en lrclib.net"
                       Foreground="#99FFFFFF"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Layer 5: Letras con scroll -->
        <ScrollViewer x:Name="LyricsScroll"
                      VerticalScrollBarVisibility="Hidden"
                      Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibleConverter}}">
            <ItemsControl ItemsSource="{Binding Lines}"
                          Margin="0,64,0,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                   FontSize="{Binding IsActive, Converter={StaticResource BoolToFontSizeConverter}}"
                                   FontWeight="{Binding IsActive, Converter={StaticResource BoolToFontWeightConverter}}"
                                   Margin="0,10"
                                   Padding="16,4"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="700"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
